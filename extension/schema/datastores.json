        {
          "unique_name": "lockkey",
          "type": "limited-text"
        },
        {
          "unique_name": "reqid",
          "type": "limited-text"
        },
        {
          "unique_name": "createdat",
          "type": "number"
        },
        {
          "unique_name": "owner",
